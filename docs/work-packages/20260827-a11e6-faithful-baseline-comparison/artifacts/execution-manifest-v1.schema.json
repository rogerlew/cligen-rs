{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A11E6 execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "control_profile", "treatment_strategy", "member_burns", "station_count", "years", "material_ratio", "minimum_interannual_improvements", "metric_set", "runtime", "resource_bound", "confirmation_target_access", "dependencies"],
