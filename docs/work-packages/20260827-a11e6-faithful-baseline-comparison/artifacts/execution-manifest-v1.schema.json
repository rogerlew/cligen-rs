    "schema_version": {"const": 1},
    "execution_id": {"const": "a11e6-faithful-baseline-comparison-v1"},
    "control_profile": {"const": "faithful_5_32_3"},
    "treatment_strategy": {"const": "circular_fixed_block_nearest_candidate_forcing_v1"},
    "member_burns": {"const": [0, 101, 1009, 10007, 100003, 1000003, 10000019, 100000007]},
    "station_count": {"const": 20},
    "years": {"const": 16},
    "material_ratio": {"const": 0.05},
    "minimum_interannual_improvements": {"const": 4},
    "metric_set": {"const": "a11e6-fourteen-observed-error-metrics-v1"},
    "runtime": {"type": "object"},
    "resource_bound": {"type": "object"},
    "confirmation_target_access": {"const": false},
    "dependencies": {"type": "object"}
  }
}
